{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "redirects": [
    {
      "source": "/blog/price-outlook-:coinId",
      "destination": "https://www.coinsclarity.com/prediction/:coinId",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "coinsclarity.com" }],
      "destination": "https://www.coinsclarity.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://coinpedia.org https://www.coinpedia.org https://*.coinpedia.org https://coinsclarity.com https://www.coinsclarity.com"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/sitemap-static.xml", "destination": "/api/sitemap-static.xml" },
    { "source": "/sitemap-coins.xml", "destination": "/api/sitemap-coins.xml" },
    { "source": "/sitemap-news.xml", "destination": "/api/sitemap-news.xml" },
    { "source": "/sitemap-programmatic.xml", "destination": "/api/sitemap-programmatic.xml" },
    { "source": "/sitemap-blog.xml", "destination": "/api/sitemap-blog.xml" },
    { "source": "/coin/:coinId/news", "destination": "/api/coin-news?coinId=:coinId" },
    { "source": "/today/why-is-:coinId-up", "destination": "/api/today-page?kind=why&coinId=:coinId&direction=up" },
    { "source": "/today/why-is-:coinId-down", "destination": "/api/today-page?kind=why&coinId=:coinId&direction=down" },
    { "source": "/price/:coinId", "destination": "/api/today-page?kind=price&coinId=:coinId" },
    { "source": "/in/:slug", "destination": "/api/today-page?kind=india&slug=:slug" },
    { "source": "/in", "destination": "/api/today-page?kind=india&slug=" },
    { "source": "/etf/bitcoin-flows", "destination": "/api/today-page?kind=etf" },
    { "source": "/tools/profit-calculator", "destination": "/api/today-page?kind=calc&slug=profit-calculator" },
    { "source": "/tools/dca-calculator", "destination": "/api/today-page?kind=calc&slug=dca-calculator" },
    { "source": "/tools/staking-calculator", "destination": "/api/today-page?kind=calc&slug=staking-calculator" },
    { "source": "/tools/liquidation-calculator", "destination": "/api/today-page?kind=calc&slug=liquidation-calculator" },
    { "source": "/tools/crypto-tax-calculator", "destination": "/api/today-page?kind=calc&slug=crypto-tax-calculator" },
    { "source": "/blog/:id", "destination": "/api/blog/:id" },
    { "source": "/prediction/:id", "destination": "/api/prediction/:id" },
    { "source": "/news/:id", "destination": "/api/news/:id" },
    { "source": "/coin/:id", "destination": "/api/coin/:id" },
    {
      "source": "/backend/:path*",
      "destination": "https://camify.fun.coinsclarity.com/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
